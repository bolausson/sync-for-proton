<?xml version="1.0" encoding="utf-8"?>
<!-- Calm redesign — theme + reusable component styles. -->
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.SyncForProton" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- accent -->
        <item name="colorPrimary">@color/sfp_primary</item>
        <item name="colorPrimaryVariant">@color/sfp_primary</item>
        <item name="colorOnPrimary">@color/sfp_on_primary</item>
        <item name="colorSecondary">@color/sfp_primary</item>
        <item name="colorOnSecondary">@color/sfp_on_primary</item>

        <!-- surfaces -->
        <item name="android:colorBackground">@color/sfp_window</item>
        <item name="colorSurface">@color/sfp_surface</item>
        <item name="colorOnSurface">@color/sfp_text</item>
        <item name="colorOnBackground">@color/sfp_text</item>
        <item name="colorError">@color/sfp_danger</item>

        <!-- keep dark cards the exact token colour (no elevation tint) -->
        <item name="elevationOverlayEnabled">false</item>

        <!-- system bars follow the window background -->
        <item name="android:statusBarColor">@color/sfp_window</item>
        <item name="android:navigationBarColor">@color/sfp_window</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>

        <!-- default component styles -->
        <item name="materialCardViewStyle">@style/Widget.SyncForProton.Card</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.SyncForProton.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.SyncForProton.Medium</item>
    </style>

    <style name="Theme.SyncForProton.DayNight" parent="Theme.SyncForProton" />

    <!-- shapes -->
    <style name="ShapeAppearance.SyncForProton.Small" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerSize">@dimen/sfp_radius_field</item>
    </style>
    <style name="ShapeAppearance.SyncForProton.Medium" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerSize">@dimen/sfp_radius_group</item>
    </style>

    <!-- cards (groups) -->
    <style name="Widget.SyncForProton.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/sfp_surface</item>
        <item name="strokeWidth">0dp</item>
        <item name="cardCornerRadius">@dimen/sfp_radius_group</item>
        <item name="contentPadding">0dp</item>
    </style>

    <style name="Widget.SyncForProton.Card.Hero">
        <item name="cardCornerRadius">@dimen/sfp_radius_hero</item>
    </style>

    <!-- buttons: Filled primary -->
    <style name="Widget.SyncForProton.Button" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textSize">@dimen/sfp_text_button</item>
        <item name="android:minHeight">@dimen/sfp_button_height</item>
        <item name="cornerRadius">@dimen/sfp_radius_button</item>
        <item name="backgroundTint">@color/sfp_primary</item>
        <item name="android:textColor">@color/sfp_on_primary</item>
        <item name="iconTint">@color/sfp_on_primary</item>
        <item name="iconPadding">8dp</item>
    </style>

    <!-- Soft / tonal -->
    <style name="Widget.SyncForProton.Button.Soft">
        <item name="backgroundTint">@color/sfp_primary_container</item>
        <item name="android:textColor">@color/sfp_on_primary_container</item>
        <item name="iconTint">@color/sfp_on_primary_container</item>
    </style>

    <!-- Ghost / outlined -->
    <style name="Widget.SyncForProton.Button.Ghost" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/sfp_text_button</item>
        <item name="android:minHeight">@dimen/sfp_button_height</item>
        <item name="cornerRadius">@dimen/sfp_radius_button</item>
        <item name="strokeColor">@color/sfp_hairline</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/sfp_text</item>
        <item name="iconTint">@color/sfp_text</item>
    </style>

    <!-- Segment of a single-choice filter, sized and coloured for the dark console strip
         rather than the light Calm surfaces. Deliberately quieter than Ghost: this picks a
         lens on what is already on screen, it does not perform an action. -->
    <style name="Widget.SyncForProton.Button.Segment" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">12.5sp</item>
        <item name="android:minHeight">32dp</item>
        <item name="android:minWidth">62dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="cornerRadius">8dp</item>
        <item name="strokeColor">@color/sfp_console_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/sfp_segment_text</item>
        <item name="backgroundTint">@color/sfp_segment_bg</item>
        <item name="rippleColor">@color/sfp_brand_violet</item>
    </style>

    <!-- Quiet text action. Sits below Ghost in the hierarchy: for things that must stay findable
         without competing with the screen's real action, like the diagnostics link on the login
         screen. Accent-coloured rather than faint, so it still reads as tappable. -->
    <style name="Widget.SyncForProton.Button.Quiet" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <!-- TextButton's parent tracks at ~0.089em, which reads as spaced-out next to every other
             button in the app. Match the primary button's tracking instead. -->
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textSize">@dimen/sfp_text_button</item>
        <item name="android:textColor">@color/sfp_primary</item>
        <item name="iconTint">@color/sfp_primary</item>
        <item name="iconPadding">8dp</item>
    </style>

    <!-- Danger text -->
    <style name="Widget.SyncForProton.Button.Danger" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/sfp_text_button</item>
        <item name="android:textColor">@color/sfp_danger</item>
        <item name="iconTint">@color/sfp_danger</item>
    </style>

    <!-- text appearances -->
    <style name="TextAppearance.SyncForProton.ScreenTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">@dimen/sfp_text_screen_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/sfp_text</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.SyncForProton.SectionLabel" parent="TextAppearance.MaterialComponents.Overline">
        <item name="android:textSize">@dimen/sfp_text_section_label</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textColor">@color/sfp_text_faint</item>
    </style>

    <!-- filter chip (Sync log) -->
    <style name="Widget.SyncForProton.Chip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipCornerRadius">@dimen/sfp_radius_pill</item>
        <item name="android:textColor">@color/sfp_text_secondary</item>
        <item name="chipBackgroundColor">@color/sfp_surface</item>
        <item name="chipStrokeWidth">0dp</item>
    </style>
</resources>
