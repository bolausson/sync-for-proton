<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/backup_data_title"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:navigationContentDescription="@string/btn_navigate_back"
            app:titleTextAppearance="@style/TextAppearance.MaterialComponents.Headline6" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/backup_data_intro"
            android:textSize="14sp"
            android:alpha="0.75" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_backup_enabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/backup_enable_auto"
            android:textSize="16sp" />

        <!-- Folder -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/backup_section_folder"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_choose_folder"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/backup_choose_folder" />

        <TextView
            android:id="@+id/text_backup_folder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/backup_folder_none"
            android:textSize="13sp"
            android:alpha="0.75" />

        <!-- Schedule -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/backup_section_schedule"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/backup_interval_label"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/et_interval_days"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:gravity="center"
                android:importantForAutofill="no"
                android:text="@string/backup_default_interval" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/backup_unit_days"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/backup_retention_label"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/et_retention"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:gravity="center"
                android:importantForAutofill="no"
                android:text="@string/backup_default_retention" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/backup_unit_runs"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- What to back up -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/backup_section_contents"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/check_calendars"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/backup_include_calendars_label" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/check_contacts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/backup_include_contacts_label" />

        <!-- Encryption -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/backup_section_encryption"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_encrypt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/backup_encrypt_label"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/backup_encrypt_explainer"
            android:textSize="13sp"
            android:alpha="0.75" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_set_passphrase"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/backup_set_passphrase" />

        <TextView
            android:id="@+id/text_passphrase_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/backup_passphrase_not_set"
            android:textSize="13sp"
            android:alpha="0.75" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_test_passphrase"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/backup_test_passphrase" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="22dp"
            android:background="?android:attr/listDivider" />

        <!-- Run now -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_backup_now"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/backup_run_now" />

        <TextView
            android:id="@+id/text_last_backup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/backup_last_never"
            android:textSize="13sp"
            android:alpha="0.75" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="22dp"
            android:background="?android:attr/listDivider" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_decrypt_backup"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/backup_decrypt_action" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:text="@string/backup_restore_hint"
            android:textSize="12sp"
            android:alpha="0.65" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
