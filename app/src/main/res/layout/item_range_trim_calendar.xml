<?xml version="1.0" encoding="utf-8"?>
<!-- One calendar in dialog_range_trim: the whole row toggles the box and reads as one checkbox to TalkBack. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingVertical="6dp">

    <CheckBox
        android:id="@+id/trim_check"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/trim_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/sfp_text"
            android:textSize="@dimen/sfp_text_row_title" />

        <TextView
            android:id="@+id/trim_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/sfp_text_secondary"
            android:textSize="@dimen/sfp_text_row_value" />
    </LinearLayout>
</LinearLayout>
